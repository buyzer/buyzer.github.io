<section
  id="contact"
  class="py-16 lg:py-20 border-t scroll-mt-[80px]"
  style="border-color: var(--border);"
>
  <div
    class="rounded-[32px] border p-5 sm:p-8 lg:p-10 overflow-hidden relative"
    style="background: var(--card); border-color: var(--border);"
  >
    <div
      class="absolute -top-24 -right-24 w-[400px] h-[400px] rounded-full blur-[80px] opacity-[0.15] pointer-events-none"
      style="background: var(--primary);"
    ></div>
    <div class="relative grid lg:grid-cols-[1.4fr_0.8fr] gap-8 lg:gap-10 items-start">
      <div class="min-w-0 text-center">
        <div class="mono text-[13px] uppercase tracking-[0.14em] text-[var(--text-faint)] mb-4">
          Open to a new team
        </div>
        <h2 class="text-[26px] sm:text-[28px] lg:text-[36px] leading-[1.3] tracking-[-0.03em] font-bold">
          Have a <span style="color: var(--primary);">WordPress</span> codebase that needs a Senior Developer?<br/>
          Let's talk about your website and where I'd start
        </h2>
        <div class="mt-8 flex flex-col md:flex-row md:flex-wrap justify-center gap-3 items-stretch md:items-center">
          <a
            href="/cv.pdf"
            class="w-full md:w-auto inline-flex items-center justify-center text-center px-6 min-h-[52px] md:min-h-[48px] rounded-full gap-2 text-[14px] font-bold"
            style="background: rgb(255, 140, 26); color: rgb(17, 17, 17);"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[18px] h-[18px] shrink-0"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download CV</span>
          </a>
          <a
            href="https://linkedin.com/in/buyung-abadi"
            target="_blank"
            rel="noopener"
            class="w-full md:w-auto inline-flex items-center justify-center text-center px-6 min-h-[52px] md:min-h-[48px] rounded-full gap-2 border text-[14px] font-bold"
            style="background: var(--bg); border-color: var(--border);"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-[18px] h-[18px] shrink-0"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.777 13.019H3.56V9h3.554v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
            <span>LinkedIn</span>
            <span class="opacity-60 text-[11px]">↗</span>
          </a>
          <a
            href="mailto:buyung.abc@gmail.com"
            class="w-full md:w-auto inline-flex items-center justify-center text-center px-6 min-h-[52px] md:min-h-[48px] rounded-full gap-2 border text-[14px] font-bold"
            style="background: var(--bg); border-color: var(--border);"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[18px] h-[18px] shrink-0"
              aria-hidden="true"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Email Me</span>
          </a>
        </div>
        <div class="mt-6 text-[16px] text-[var(--text-muted)] leading-[1.4]">
          Open to Remote or Hybrid Work • Fractional Roles • Contract-to-Hire •
          Flexible overlap EU/US
        </div>
      </div>
      <div
        class="rounded-[20px] border p-6 md:p-7 overflow-hidden w-full min-w-0"
        style="background: var(--bg); border-color: rgb(42, 42, 50);"
      >
        <div class="mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-faint)] mb-2">
          Contact for Hiring Managers
        </div>
        <div class="divide-y divide-white/[0.06]">
          <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-3.5">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0">
              Email
            </span>
            <a
              href="mailto:buyung.abc@gmail.com"
              class="text-[14px] md:text-[14px] font-medium break-all leading-[1.4] hover:text-[var(--primary)] transition-colors"
            >
              buyung.abc@gmail.com
            </a>
          </div>
          <div class="flex flex-col md:flex-row md:items-start gap-1 md:gap-4 py-3.5">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0 md:pt-[2px]">
              LinkedIn
            </span>
            <a
              href="https://linkedin.com/in/buyung-abadi"
              target="_blank"
              rel="noopener"
              class="text-[14px] font-medium break-all leading-[1.4] hover:text-[var(--primary)] transition-colors min-w-0"
            >
              linkedin.com/in/buyung-abadi
            </a>
          </div>
          <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-3.5">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0">
              GitHub
            </span>
            <a
              href="https://github.com/buyzer"
              target="_blank"
              rel="noopener"
              class="text-[14px] font-medium break-all leading-[1.4] hover:text-[var(--primary)] transition-colors"
            >
              github.com/buyzer
            </a>
          </div>
          <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-3.5">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0">
              Location
            </span>
            <span class="text-[14px] font-medium leading-[1.4]">
              Magetan, East Java, Indonesia
            </span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-3.5">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0">
              Timezone
            </span>
            <span class="text-[14px] font-medium leading-[1.4]">GMT+7</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-start gap-1 md:gap-4 py-3.5 border-b-0">
            <span class="mono text-[11px] uppercase tracking-wide text-[var(--text-muted)] md:min-w-[85px] md:max-w-[85px] shrink-0 md:pt-[2px]">
              Availability
            </span>
            <span class="text-[14px] font-medium leading-[1.4] break-words">
              Immediately • 40+ hours/week
            </span>
          </div>
        </div>
        
      </div>
    </div>
    <div
      class="mt-10 flex flex-col items-center justify-center gap-3 mono text-[13px] text-[var(--text-faint)] border-t pt-6 text-center"
      style="border-color: var(--border);"
    >
      <div class="text-center leading-[1.6] max-w-full break-words px-2">
        © {new Date().getFullYear()} Buyung Abadi • Senior WordPress Engineer & Ex-Tech Lead • Indonesia
      </div>
      <div class="flex flex-col md:flex-row items-center justify-center gap-2 mt-1">
        <span
          class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full border mx-auto text-[11px] mono tracking-[0.06em] uppercase"
          style="border-color: var(--border); background: var(--bg-soft); color: var(--text-muted);"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            class="w-3.5 h-3.5 text-[var(--primary)]"
            aria-hidden="true"
          >
            <path
              d="M12 2.5L3 7l9 14.5L21 7L12 2.5Z"
              fill="currentColor"
              opacity="0.9"
            ></path>
            <path
              d="M12 2.5V21.5"
              stroke="var(--bg)"
              stroke-width="1.2"
              stroke-linecap="round"
            ></path>
            <path
              d="M3 7L12 12L21 7"
              stroke="var(--bg)"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <a href="https://astro.build" target="_blank" rel="noopener noreferrer nofollow" class="hover:text-[var(--primary)] transition-colors">
            built with Astro
          </a>
        </span>
      </div>
    </div>
  </div>
</section>
