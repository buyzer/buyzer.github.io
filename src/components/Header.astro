---
---

<header
  id="site-header"
  class="site-header sticky z-40 backdrop-blur-xl border-b transition-all top-0"
  style="top:var(--safe-area-inset-top);"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-8 h-[68px] flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="#top" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-[13px] mono bg-[var(--card)] border border-[var(--border)] group-hover:border-[var(--primary)] transition-colors">
          BA
        </div>
        <span class="mono text-[13px] tracking-[0.02em] font-medium hidden sm:inline">
          <span class="opacity-60">/</span> Buyung Abadi
        </span>
      </a>
      <nav class="hidden lg:flex items-center gap-6">
        <button
          data-nav="team-value"
          class="mono text-[11px] uppercase tracking-[0.14em] transition-colors relative pb-[2px] text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          Expertise
          <span class="absolute left-0 -bottom-[6px] h-[2px] bg-[var(--primary)] transition-all duration-300 w-0 opacity-0"></span>
        </button>
        <button
          data-nav="experience"
          class="mono text-[11px] uppercase tracking-[0.14em] transition-colors relative pb-[2px] text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          Experience
          <span class="absolute left-0 -bottom-[6px] h-[2px] bg-[var(--primary)] transition-all duration-300 w-0 opacity-0"></span>
        </button>
        <button
          data-nav="stack"
          class="mono text-[11px] uppercase tracking-[0.14em] transition-colors relative pb-[2px] text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          Stack
          <span class="absolute left-0 -bottom-[6px] h-[2px] bg-[var(--primary)] transition-all duration-300 w-0 opacity-0"></span>
        </button>
        <button
          data-nav="work"
          class="mono text-[11px] uppercase tracking-[0.14em] transition-colors relative pb-[2px] text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          Projects
          <span class="absolute left-0 -bottom-[6px] h-[2px] bg-[var(--primary)] transition-all duration-300 w-0 opacity-0"></span>
        </button>
        <button
          data-nav="contact"
          class="mono text-[11px] uppercase tracking-[0.14em] transition-colors relative pb-[2px] text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          Contact
          <span class="absolute left-0 -bottom-[6px] h-[2px] bg-[var(--primary)] transition-all duration-300 w-0 opacity-0"></span>
        </button>
      </nav>
    </div>
    <div class="flex items-center gap-3">
      <span
        class="hidden md:inline-flex items-center gap-2 px-3.5 h-8 rounded-full text-[11px] mono uppercase tracking-[0.08em] font-semibold border"
        style="background:var(--card);border-color:var(--border);color:var(--text-muted);"
      >
        <span
          class="w-1.5 h-1.5 rounded-full animate-pulse"
          style="background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,0.18);"
        ></span>
        Open to Remote or Hybrid Work
      </span>
      <button
        id="theme-toggle"
        aria-label="Toggle theme"
        class="w-9 h-9 rounded-full border flex items-center justify-center hover:border-[var(--border-strong)] transition-colors"
        style="background:var(--card);border-color:var(--border);"
      >
        <span class="text-[15px]">☀</span>
      </button>
      <button
        id="mobile-menu-btn"
        class="lg:hidden w-9 h-9 rounded-full border flex items-center justify-center"
        style="background:var(--card);border-color:var(--border);"
      >
        <div class="w-4 flex flex-col gap-1">
          <span class="h-[2px] bg-[var(--text)] block transition-all"></span>
          <span class="h-[2px] bg-[var(--text)] block"></span>
          <span class="h-[2px] bg-[var(--text)] block transition-all"></span>
        </div>
      </button>
    </div>
  </div>
  <div
    id="mobile-drawer"
    class="lg:hidden hidden border-t w-full px-5 py-5 space-y-5"
    style="border-color:var(--border);background:var(--bg);"
  >
    <div class="w-full">
      <span
        class="w-full min-h-[48px] flex items-center justify-center gap-2.5 px-4 py-3 rounded-full text-[11px] mono uppercase tracking-[0.08em] font-semibold border text-center"
        style="background:var(--card);border-color:var(--border);color:var(--text-muted);"
      >
        <span
          class="w-2 h-2 rounded-full bg-[#22c55e] animate-pulse shrink-0"
          style="box-shadow:0 0 0 3px rgba(34,197,94,0.18);"
        ></span>
        Open to Remote or Hybrid Work
      </span>
    </div>
    <nav class="flex flex-col gap-1">
      <button
        data-nav="team-value"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Expertise</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
      <button
        data-nav="experience"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Experience</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
      <button
        data-nav="stack"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Stack</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
      <button
        data-nav="work"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Projects</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
      <button
        data-nav="education"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Education</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
      <button
        data-nav="contact"
        class="w-full text-left flex items-center justify-between gap-3 py-3.5 px-4 rounded-xl mono text-[13px] tracking-wide transition-colors min-h-[48px] border border-transparent text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--card)] hover:border-[var(--border)]"
      >
        <span>Contact</span>
        <span class="text-[12px] opacity-40">↗</span>
      </button>
    </nav>
    <div class="pt-3 border-t space-y-3" style="border-color:var(--border);">
      <div class="grid grid-cols-2 gap-3">
        <a
          href="/cv.pdf"
          class="w-full min-h-[48px] h-[48px] px-4 inline-flex items-center justify-center rounded-full text-[13px] font-semibold gap-1.5"
          style="background:var(--primary);color:#111;"
        >
          <span>Download CV</span>
          <span>↓</span>
        </a>
        <a
          href="https://github.com/buyzer"
          target="_blank"
          rel="noopener"
          class="w-full min-h-[48px] h-[48px] px-4 inline-flex items-center justify-center rounded-full border mono text-[13px] font-medium gap-2"
          style="border-color:var(--border);background:var(--card);"
        >
          <span>GitHub</span>
        </a>
      </div>
      <a
        href="mailto:buyung.abc@gmail.com"
        class="w-full min-h-[48px] h-[48px] px-4 inline-flex items-center justify-center rounded-full border mono text-[13px] font-medium"
        style="border-color:var(--border);background:var(--card);"
      >
        <span>Email: buyung.abc@gmail.com</span>
      </a>
    </div>
  </div>
</header>
