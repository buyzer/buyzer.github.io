---
---

<section
  id="team-value"
  class="py-16 lg:py-20 border-t scroll-mt-[80px]"
  style="border-color:var(--border);"
>
  <div class="w-full flex flex-col items-center text-center mb-10">
    <h2 class="text-[28px] lg:text-[34px] tracking-[-0.03em] font-bold text-center max-w-3xl mx-auto w-full">
      What I Do
    </h2>
  </div>
  <div class="grid md:grid-cols-3 gap-5">
    <div
      class="group rounded-2xl border p-7 hover:border-[var(--primary)]/50 transition-colors"
      style="background:var(--card);border-color:var(--border);"
    >
      <div class="flex items-center gap-3 mb-6">
        <span
          class="w-2 h-2 rounded-full"
          style="background:var(--primary);"
        ></span>
        <h3 class="font-semibold tracking-[-0.01em] text-[15px]">
          Custom WordPress Development
        </h3>
      </div>
      <ul class="space-y-3">
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Create Themes & Plugins from scratch
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Custom Post Types, Custom Database, Hooks & Filters
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Optimized WP_Query & Custom SQL Queries
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          WooCommerce Cart & Checkout Customization
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Third-Party API Integrations (Payments, Webhooks, etc)
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Headless WordPress with Astro frontend
        </li>
      </ul>
    </div>
    <div
      class="group rounded-2xl border p-7 hover:border-[var(--primary)]/50 transition-colors"
      style="background:var(--card);border-color:var(--border);"
    >
      <div class="flex items-center gap-3 mb-6">
        <span
          class="w-2 h-2 rounded-full"
          style="background:var(--primary);"
        ></span>
        <h3 class="font-semibold tracking-[-0.01em] text-[15px]">
          Security, Performance & SEO
        </h3>
      </div>
      <ul class="space-y-3">
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Core Web Vitals Audits & Fixes
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Technical SEO (on-page, link building, GSC, GA4)
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Security Hardening & Malware Cleanup
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          VPS / Docker / Nginx / Caching / Cloudflare
        </li>
      </ul>
    </div>
    <div
      class="group rounded-2xl border p-7 hover:border-[var(--primary)]/50 transition-colors"
      style="background:var(--card);border-color:var(--border);"
    >
      <div class="flex items-center gap-3 mb-6">
        <span
          class="w-2 h-2 rounded-full"
          style="background:var(--primary);"
        ></span>
        <h3 class="font-semibold tracking-[-0.01em] text-[15px]">
          Workflow & Delivery
        </h3>
      </div>
      <ul class="space-y-3">
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Code Review & Pull Requests
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Team Coordination Asana / Git
        </li>
        <li class="flex gap-3 text-[13px] leading-[1.5] text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
          <span class="mt-[7px] w-1 h-1 rounded-full bg-[var(--text-faint)] shrink-0"></span>
          Site Audit & Fixes
        </li>
      </ul>
    </div>
  </div>
</section>
